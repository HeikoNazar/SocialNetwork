@model SocialNetwork.ViewModels.Account.ProfileVM

@{
	ViewData["Title"] = "My Account";
	ViewData["ReturnUrl"] = Url.Action("Index", "Account");
}

<div id="site__main" class="container">
	<div class="row justify-content-center">
		<div class="col-md-8">

			<div class="card mb-4">
				<div class="card-body">
					<div class="d-flex align-items-center">
						<img src="@(Model.ProfilePictureUrl ?? "/images/user.png")" alt="@Model.FullName" class="rounded-circle me-4" width="120" height="120" style="object-fit: cover;" />
						<div>
							<h4 class="mb-0">@Model.FullName</h4>
							<div class="text-muted mb-2">@@@Model.UserHandle</div>
							<div>
								<strong>@Model.SubscribersCount</strong> subscribers
								<span class="mx-2">&middot;</span>
								<strong>@Model.SubscriptionsCount</strong> subscriptions
							</div>
						</div>
					</div>

					<hr />

					@if (TempData["PictureError"] is string pictureError)
					{
						<div class="alert alert-danger py-2">@pictureError</div>
					}
					@if (TempData["PictureSuccess"] is string pictureSuccess)
					{
						<div class="alert alert-success py-2">@pictureSuccess</div>
					}

					<form asp-controller="Account" asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="d-flex align-items-center">
						<label class="btn btn-outline-primary btn-sm mb-0">
							Change picture
							<input type="file" name="picture" accept="image/png,image/jpeg,image/gif,image/webp" hidden onchange="this.form.submit()" />
						</label>
						<small class="text-muted ms-3">JPG, PNG, GIF or WebP, up to 2 MB</small>
					</form>
				</div>
			</div>

			<partial name="Components/_CreatePost" model="new PostVM()"></partial>

			<h5 class="mb-3">My posts</h5>
			<div id="posts-container">
			@if (Model.Posts.Count == 0)
			{
				<div class="text-muted text-center">You have not published any posts yet.</div>
			}
			else
			{
				@foreach (var post in Model.Posts)
				{
					<partial name="Home/_Post" model="post"></partial>
				}
			}
			</div>
		</div>
	</div>
</div>

<partial name="Home/_PostsScripts" />

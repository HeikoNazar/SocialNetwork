@model List<Post>

@{
	var hashtag = ViewData["Hashtag"] as string ?? "";
	ViewData["Title"] = "#" + hashtag;
}

<div id="site__main" class="container">
	<div class="row justify-content-center">
		<div class="col-md-8">
			<h4 class="mb-3">#@hashtag</h4>
			<div id="posts-container">
			@if (Model.Count == 0)
			{
				<div class="text-muted text-center">There are no posts with this hashtag.</div>
			}
			else
			{
				@foreach (var post in Model)
				{
					<partial name="Home/_Post" model="post"></partial>
				}
			}
			</div>
		</div>
	</div>
</div>

<partial name="Home/_PostsScripts" />
